# 生产环境配置（bbs.jnsec.org）。部署：cp .env.example .env（compose 自动读取同目录 .env）

# 数据库（MySQL 5.7，复用现有 bbsmysql 数据卷；Go 直接读写其中的 flarum 库）
# 注意：数据卷已初始化过，此值必须是现有库的 root 密码——
#       首次启动后修改它不会改变真实密码，只会导致 app/健康检查连不上
MYSQL_ROOT_PASSWORD=123456

# 应用
SITE_NAME=JNSEC BBS
# 会话与 CSRF 密钥（已生成 64 位随机值，可按需更换）
SESSION_SECRET=fd19ec25c8913465de3e6d67c911950dc50af8205823b994077da989d72dce6c
# 站点经 HTTPS 反代时保持 true
COOKIE_SECURE=true
REGISTRATION=invite
APP_PORT=8080
TZ=Asia/Shanghai

# 旧 Flarum 静态资源在 wwwdata 卷内的路径（compose 里 wwwdata 挂载到 /flarum）
# 若旧站目录结构不是标准 flarum 骨架（public/assets），用此变量修正
ASSETS_DIR=/flarum/public/assets

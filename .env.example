# 部署模板：复制为 .env 后填写本机真实配置，不能原样用于生产。

# 数据库（MySQL 5.7，复用现有 bbsmysql 数据卷；旧 PHP 使用 flarum，新 Go 使用独立 bbs 库）
# 注意：数据卷已初始化过，此值必须是现有库的 root 密码——
#       首次启动后修改它不会改变真实密码，只会导致 app/健康检查连不上
MYSQL_ROOT_PASSWORD=CHANGE-ME

# 应用
SITE_NAME=JNSEC BBS
# 会话与 CSRF 密钥：使用 openssl rand -hex 32 生成，每个站点独立配置
SESSION_SECRET=CHANGE-ME-to-a-random-64-char-string
# 站点经 HTTPS 反代时保持 true
COOKIE_SECURE=true
# CSRF 同源白名单（逗号分隔，完整 Origin 含协议）
TRUSTED_ORIGINS=https://bbs.jnsec.org,https://new.bbs.jnsec.org
REGISTRATION=invite
APP_PORT=8080
TZ=Asia/Shanghai

# 旧 Flarum 静态资源在 wwwdata 卷内的路径（compose 里 wwwdata 挂载到 /flarum）
# 若旧站目录结构不是标准 flarum 骨架（public/assets），用此变量修正
ASSETS_DIR=/flarum/public/assets

# Go application database, separate from the legacy PHP flarum database.
# For the five-minute mirror, grant SELECT on bbs.* and writes ONLY on bbs.flarum_access_tokens.
# Flarum 以 UTC 存 DATETIME：必须 loc=UTC，按本地时区解析会让前端相对时间偏差 8 小时。
APP_DB_DSN=bbs_app:CHANGE-ME@tcp(mysql:3306)/bbs?charset=utf8mb4&parseTime=true&loc=UTC
READ_ONLY=true
